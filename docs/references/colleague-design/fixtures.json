      "case": {"token_in": "USDC", "token_out": "USDT", "amount_in": "1000000001"},
      "pools": {"X": ["USDC", "WETH"], "Y": ["USDC", "WETH"], "C": ["USDC", "DAI"], "V": ["DAI", "WETH"], "Z": ["WETH", "USDT"]},
      "slot_tokens": ["USDC", "WETH", "WETH", "DAI", "WETH", "WETH", "USDT"],
      "program": [
        {"n": 0, "pool": "X", "input": ["SINGLE", 0, "BPS", 5000], "out": 1},
        {"n": 1, "pool": "Y", "input": ["SINGLE", 0, "BPS", 3500], "out": 2},
        {"n": 2, "pool": "C", "input": ["SINGLE", 0, "REMAINDER", 0], "out": 3},
        {"n": 3, "pool": "V", "input": ["SINGLE", 3, "ALL", 0], "out": 4},
        {"n": 4, "pool": "Z", "input": ["MERGE_INTO", 5, "ALL", 0, [1, 2, 4]], "out": 6}
      ],
      "scripted_outputs": [
        {"pool": "X", "amount_in": "500000000", "amount_out": "150000000000000000", "origin": "source (P10: 0.150 WETH)"},
        {"pool": "Y", "amount_in": "350000000", "amount_out": "104000000000000000", "origin": "source (P10: 0.104 WETH)"},
        {"pool": "C", "amount_in": "150000001", "amount_out": "150000001000000000000", "origin": "fixture (source gives no DAI amount)"},
        {"pool": "V", "amount_in": "150000001000000000000", "amount_out": "44000000000000000", "origin": "source (P10: 0.044 WETH)"},
        {"pool": "Z", "amount_in": "298000000000000000", "amount_out": "995000000", "origin": "fixture (source gives no USDT amount)"}
      ],
      "expected_trace": [
        {"n": 0, "amount_in": "500000000", "amount_out": "150000000000000000", "why": "IR-1"},
        {"n": 1, "amount_in": "350000000", "amount_out": "104000000000000000", "why": "IR-1: base is still 1000000001, not the 500000001 left"},
        {"n": 2, "amount_in": "150000001", "amount_out": "150000001000000000000", "why": "IR-1 remainder"},
        {"n": 3, "amount_in": "150000001000000000000", "amount_out": "44000000000000000", "why": "ALL of slot 3"},
        {"n": 4, "amount_in": "298000000000000000", "amount_out": "995000000", "merged_base": "298000000000000000", "why": "150e15 + 104e15 + 44e15 (P10: 0.298 WETH); ALL of merged slot 5"}
      ],
      "expected_route_plan": [
        {"pool": "X", "token_in": "USDC", "token_out": "WETH", "inputs": [["REQUEST", "500000000"]], "out": "s1"},
        {"pool": "Y", "token_in": "USDC", "token_out": "WETH", "inputs": [["REQUEST", "350000000"]], "out": "s2"},
        {"pool": "C", "token_in": "USDC", "token_out": "DAI", "inputs": [["REQUEST", "ALL_REMAINING"]], "out": "s3"},
        {"pool": "V", "token_in": "DAI", "token_out": "WETH", "inputs": [["s3", "ALL_REMAINING"]], "out": "s4"},
        {"pool": "Z", "token_in": "WETH", "token_out": "USDT", "inputs": [["s1", "ALL_REMAINING"], ["s2", "ALL_REMAINING"], ["s4", "ALL_REMAINING"]], "out": "s6"}
      ],
      "expected_evaluation": {"status": "ok", "gross_output": "995000000", "pool_calls": 5, "zero_input_steps": 0},
      "negative_variants": [
