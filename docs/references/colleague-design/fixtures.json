    "scripted_outputs": "pure (pool, amount_in) -> amount_out table used as the evaluator's quote seam. origin 'source' = a demo value printed by the attachment; origin 'fixture' = chosen here for replay only and never evidence of pool math",
    "expected_*": "derived by hand from the M3 rules (contract §5). The derivations are recorded next to each value. They are not generated by the code under test",
    "route_plan": "canonical recovery (contract §5.3). Each input is [fund_id, amount|ALL_REMAINING]. Slot k's fund id is 's<k>'; slot 0 is 'REQUEST'"
  },
  "integer_rules": [
    {
      "id": "IR-1-root-remainder",
      "source": "P2, P9",
      "base": "1000000001",
      "branches": [["BPS", 5000], ["BPS", 3500], ["REMAINDER", 0]],
      "expected": ["500000000", "350000000", "150000001"],
      "derivation": "1000000001*5000//10000 = 500000000 (exact 500000000.5); 1000000001*3500//10000 = 350000000 (exact 350000000.35); 1000000001 - 500000000 - 350000000 = 150000001",
      "flattened_invalid": {"branches": [["BPS", 5000], ["BPS", 3500], ["BPS", 1500]], "values": ["500000000", "350000000", "150000000"], "unallocated": "1"}
    },
    {
      "id": "IR-2-nested-vs-flattened",
      "source": "P9",
      "base": "3",
      "layers": [5000, 8000],
      "expected_nested": "0",
      "derivation": "floor(3*5000/10000) = 1; floor(1*8000/10000) = 0",
      "flattened_bps": 4000,
      "flattened_invalid_value": "1",
      "flattened_derivation": "floor(3*4000/10000) = floor(1.2) = 1"
    },
    {
      "id": "IR-3-appendix-layers",
      "source": "P18",
      "groups": [
        {"base": "1001", "bps": 6000, "expected": ["600", "401"], "derivation": "floor(600.6) = 600; 1001 - 600 = 401"},
        {"base": "301", "bps": 2500, "expected": ["75", "226"], "derivation": "floor(75.25) = 75; 301 - 75 = 226"},
        {"base": "1003", "bps": 4000, "expected": ["401", "602"], "derivation": "floor(401.2) = 401; 1003 - 401 = 602"}
      ]
    },
    {
      "id": "IR-4-merge-then-split",
      "source": "P22",
      "members": ["101", "199"],
      "bps": 6000,
      "expected": {"base": "300", "first": "180", "rest": "120"},
      "derivation": "101 + 199 = 300; floor(300*6000/10000) = 180; 300 - 180 = 120"
    }
  ],
  "plans": [
